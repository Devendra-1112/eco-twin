# EcoTwin Environment Configuration
# Copy this to .env or set in Cloudflare Pages / Vercel Environment Variables

# Primary Gemini API Key (multimodal AI queries & briefings)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallback API Keys for high-availability auto-failover
GEMINI_API_KEY_FALLBACK_1=your_backup_gemini_key_1
GEMINI_API_KEY_FALLBACK_2=your_backup_gemini_key_2

# Recommended model endpoint
GEMINI_MODEL=gemini-2.5-flash
